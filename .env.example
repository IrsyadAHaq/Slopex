# ===== SERVER =====
PORT=8828
NODE_ENV=development

# ===== DATABASE =====
# Database lokal JSON (otomatis tersimpan di folder data/)

# ===== JWT =====
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=30d

# ===== EMAIL SMTP =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password
BASE_URL=http://localhost:8828

# ===== AI SERVICES =====
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest

# ===== ESP32 DEVICE TOKEN =====
DEVICE_API_KEY=your_esp32_secret_token

# ===== CHIRPSTACK LORAWAN CONFIG =====
CHIRPSTACK_API_KEY=your_chirpstack_api_key_here
CHIRPSTACK_DEV_EUI=your_device_eui_hex
CHIRPSTACK_IP=127.0.0.1
CHIRPSTACK_PORT=8090

# ===== SSH DEPLOYMENT =====
SSH_HOST=your_server_host
SSH_PORT=22
SSH_USER=slopex
SSH_PASSWORD=your_ssh_password

# ===== SLOPEX WHATSAPP BOT CONFIG =====
SLOPEX_API_URL=http://localhost:8828/api
SLOPEX_EMAIL=operator@slopex.id
SLOPEX_PASSWORD=your_operator_password
POLL_INTERVAL=15000
NOTIFY_NUMBERS=6281234567890
RISK_THRESHOLD_WARNING=50
RISK_THRESHOLD_DANGER=75
NOTIF_COOLDOWN_MINUTES=5
DAILY_REPORT_ENABLED=true
DAILY_REPORT_TIME=07:00
DEBUG=false
